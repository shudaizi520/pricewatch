# Generate once: openssl rand -hex 32
# Keep this value unchanged after setup, or encrypted settings cannot be read.
PRICEWATCH_APP_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHARACTER_HEX
PRICEWATCH_DATA_PATH=./data
PRICEWATCH_BIND=127.0.0.1
# Set to the HTTPS address of your reverse proxy before logging in over the internet.
PRICEWATCH_EXTERNAL_URL=
# Optional after the GHCR release exists: ghcr.io/YOUR_ACCOUNT/pricewatch:0.1.0
PRICEWATCH_IMAGE=pricewatch:local
